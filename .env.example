# ==========================================
# Configurações de Produção - Sistema de Férias
# ==========================================

# Segurança (IMPORTANTE: Gerar chave secreta forte em produção)
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# Cookies seguros (habilitar apenas com HTTPS)
SESSION_COOKIE_SECURE=False

# ==========================================
# Instruções de Uso
# ==========================================
# 1. Copiar este arquivo: cp .env.example .env
# 2. Editar .env e configurar valores reais
# 3. Gerar SECRET_KEY segura com: python -c "import secrets; print(secrets.token_hex(32))"
# 4. Configurar SESSION_COOKIE_SECURE=True se usar HTTPS
# 5. NUNCA commitar o arquivo .env no Git

# ==========================================
# Rate limit do login
# ==========================================

# Confiar no header CF-Connecting-IP para identificar o visitante.
# Habilite APENAS se a aplicação estiver atrás do Cloudflare (Tunnel ou proxy) e
# não for acessível diretamente pela internet. Com o Cloudflare na frente, o
# remote_addr é sempre o mesmo IP, e sem este header as tentativas erradas de uma
# pessoa bloqueariam o login de todos os usuários.
TRUST_CF_HEADER=False

# Onde guardar os contadores de tentativas. O padrão memory:// é por worker
# (o Gunicorn roda 4), então o limite efetivo é ~4x o configurado e zera a cada
# deploy. Para um contador único, aponte para um Redis: redis://redis:6379
RATELIMIT_STORAGE_URI=memory://
